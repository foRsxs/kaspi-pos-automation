# Optional for a NEW installation: keys are generated and persisted automatically.
# For upgrades keep the original TOKEN_SECRET_KEY and existing data volume.
TOKEN_SECRET_KEY=
PORT=3000

# Optional initial administrative API key (32-256 printable ASCII characters).
# Web login uses admin + a temporary password from container logs, then your own password.
# After API key rotation in Server Settings, the old ENV value is ignored.
ADMIN_API_KEY=

# Optional, one-time import of the previous JSON + environment configuration.
# Keep the old *_API_KEY / *_WEBHOOK_SECRET variables until the import completes.
# PROJECTS_FILE=./projects.json
# DATA_DIR=./data

# ─── App version & device constants (optional) ───
# Defaults match a known-good Kaspi Pay client.
# ⚠️ The Kaspi API validates these — use values from a real device cookie.
# Kaspi raises its minimum app version periodically; when it does, login fails at the phone step with
# "OldVersionToUpdate" for every cashier. Set these to the current Kaspi Pay iOS release + build and restart.
# APP_VERSION=26.1029
# APP_BUILD=1128
# APP_PLATFORM=iOS
# APP_PLATFORM_VER=18.4
# APP_LOCALE=ru-RU
# APP_MODEL=iPhone17,3
# APP_BRAND=Apple
# APP_DEVICE_NAME=iPhone
# APP_SCREEN_W=393.0
# APP_SCREEN_H=852.0
# APP_CFNETWORK=CFNetwork/3826.500.131
# APP_DARWIN=Darwin/24.5.0
